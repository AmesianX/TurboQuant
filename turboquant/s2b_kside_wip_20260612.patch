diff --git a/ggml/src/ggml-cuda/convert.cu b/ggml/src/ggml-cuda/convert.cu
index 5f79f2909..3e9878350 100644
--- a/ggml/src/ggml-cuda/convert.cu
+++ b/ggml/src/ggml-cuda/convert.cu
@@ -1000,6 +1000,57 @@ void tbq_output_iwht128_cuda(float * dst, int64_t n_rows, int64_t row_stride, cu
     tbq_output_iwht128_kernel<<<n_rows, 128, 0, stream>>>(dst, n_rows, row_stride);
 }
 
+// Forward WHT for Q rows against 128-block TBQ K caches (MMA typed path): the K tiles are
+// dequantized in the WHT domain, so Q must be moved there too. Mirrors the fattn-vec in-kernel
+// Q prep: q' = WHT(S*q) / 128 (the kernel applies the usual attention scale on top).
+static __global__ void tbq_q_wht128_kernel(const char * __restrict__ src, float * __restrict__ dst,
+                                           float * __restrict__ raw_copy,
+                                           int64_t ne1, int64_t ne2,
+                                           int64_t nb1, int64_t nb2, int64_t nb3) {
+    // strided source (FA's Q is a permuted view); outputs are CONTIGUOUS rows in
+    // (token + head*ne1 + seq*ne1*ne2) order — raw_copy carries the untransformed Q for the
+    // in-kernel outlier correction so downstream addressing never needs the source strides.
+    const int64_t row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    static constexpr uint8_t tbq_signs[16] = {
+        0xa7,0x3b,0x91,0xf4,0x6d,0xc2,0x58,0x0e,
+        0xb3,0x7f,0x24,0xd6,0x89,0x45,0xea,0x1c,
+    };
+
+    const int64_t i1 = row % ne1;
+    const int64_t i2 = (row / ne1) % ne2;
+    const int64_t i3 = row / (ne1*ne2);
+
+    const float * in  = (const float *)(src + i1*nb1 + i2*nb2 + i3*nb3);
+    float       * out = dst + row*128;
+    raw_copy[row*128 + tid] = in[tid];
+
+    const float sign0 = ((tbq_signs[tid >> 3] >> (tid & 7)) & 1) ? -1.0f : 1.0f;
+    float f0 = in[tid] * sign0;
+#pragma unroll
+    for (int st = 0; st < 5; st++) {
+        const float o0 = __shfl_xor_sync(0xffffffff, f0, 1 << st, 32);
+        f0 = (tid & (1 << st)) ? (o0 - f0) : (f0 + o0);
+    }
+    __shared__ float buf[128];
+    buf[tid] = f0;
+    __syncthreads();
+    { const float u = buf[tid], v = buf[tid ^ 32]; f0 = (tid & 32) ? (v - u) : (u + v); }
+    __syncthreads();
+    buf[tid] = f0;
+    __syncthreads();
+    { const float u = buf[tid], v = buf[tid ^ 64]; f0 = (tid & 64) ? (v - u) : (u + v); }
+
+    out[tid] = f0 / 128.0f;
+}
+
+void tbq_q_wht128_cuda(const char * src, float * dst, float * raw_copy,
+                       int64_t ne1, int64_t ne2, int64_t ne3,
+                       int64_t nb1, int64_t nb2, int64_t nb3, cudaStream_t stream) {
+    tbq_q_wht128_kernel<<<ne1*ne2*ne3, 128, 0, stream>>>(src, dst, raw_copy, ne1, ne2, nb1, nb2, nb3);
+}
+
 static void dequantize_row_tbq3_4_to_f16_cuda(const void * vx, half * y, int64_t k, cudaStream_t stream) {
     dequantize_tbq_4_spatial_f16_kernel<block_tbq3_4, 3><<<k/TBQ_K576, 256, 0, stream>>>(vx, y, k/TBQ_K576);
 }
